{
  "name": "@octant/monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "scripts"
    ],
    "catalog": {
      "@anthropic-ai/claude-agent-sdk": "0.3.211",
      "@opencode-ai/sdk": "1.18.0",
      "@xterm/addon-fit": "0.11.0",
      "@xterm/xterm": "6.0.0",
      "@types/bun": "1.3.14",
      "@types/better-sqlite3": "7.6.13",
      "@types/node": "26.1.1",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3",
      "better-sqlite3": "12.11.1",
      "effect": "3.21.4",
      "monaco-editor": "0.56.0",
      "node-pty": "1.1.0",
      "playwright-core": "1.62.0",
      "react": "19.2.7",
      "react-dom": "19.2.7",
      "typescript": "7.0.2",
      "vite": "8.1.4",
      "vitest": "4.1.10",
      "yaml": "2.8.3"
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "bun scripts/dev-desktop.ts",
    "paths:check": "bun test scripts/check-path-collisions.test.ts && bun scripts/check-path-collisions.ts",
    "wiring:check": "bun test scripts/check-module-wiring.test.ts && bun scripts/check-module-wiring.ts",
    "decisions:check": "bun test scripts/check-decisions.test.ts scripts/check-decision-history.test.ts && bun scripts/check-decisions.ts && bun scripts/check-decision-history.ts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --report-unused-disable-directives",
    "package:desktop": "bun scripts/package-desktop.ts",
    "smoke:packaged-chat": "bun scripts/smoke-packaged-chat.ts",
    "smoke:packaged-desktop": "bun scripts/smoke-packaged-desktop.ts",
    "smoke:packaged-openai-compatible": "bun scripts/smoke-packaged-openai-compatible.ts",
    "smoke:packaged-codex": "bun scripts/smoke-packaged-codex.ts",
    "smoke:packaged-code": "bun scripts/smoke-packaged-code.ts",
    "smoke:packaged-code-project-pull-requests": "bun scripts/smoke-packaged-code-project-pull-requests.ts",
    "smoke:packaged-agent-runs": "bun scripts/smoke-packaged-agent-runs.ts",
    "smoke:apple-toolchain": "bun scripts/smoke-apple-toolchain.ts",
    "smoke:packaged-claude": "bun scripts/smoke-packaged-claude.ts",
    "smoke:packaged-opencode": "bun scripts/smoke-packaged-opencode.ts",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "bun run paths:check && bun run wiring:check && bun run decisions:check && bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "turbo": "2.10.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
