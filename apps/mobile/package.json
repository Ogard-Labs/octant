{
  "name": "@octant/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "start": "expo start",
    "start:mock": "OCTANT_MOBILE_MOCK_SCENARIO=full expo start --web --clear",
    "start:mock:stale": "OCTANT_MOBILE_MOCK_SCENARIO=stale expo start --web --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@expo/ui": "~58.0.29",
    "@expo/vector-icons": "15.1.1",
    "@octant/client-runtime": "workspace:*",
    "@octant/contracts": "workspace:*",
    "@octant/domain": "workspace:*",
    "@octant/theme": "workspace:*",
    "@react-navigation/native": "7.5.2",
    "@react-navigation/native-stack": "7.21.1",
    "expo": "~58.0.26",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-gl": "~58.0.4",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-local-authentication": "~58.0.3",
    "expo-secure-store": "~58.0.3",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-video": "~58.0.14",
    "react": "catalog:",
    "react-dom": "19.3.1",
    "react-native": "0.88.1",
    "react-native-enriched-markdown": "1.2.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.7",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "babel-preset-expo": "~58.0.26",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  },
  "enriched-markdown": {
    "enableMath": false,
    "enableCodeHighlight": false,
    "enableVideo": false
  }
}
