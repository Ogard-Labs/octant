{
  "name": "@octant/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "start:mock": "OCTANT_MOBILE_MOCK_SCENARIO=full expo start --web --clear",
    "start:mock:stale": "OCTANT_MOBILE_MOCK_SCENARIO=stale expo start --web --clear",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@expo/vector-icons": "15.1.1",
    "@octant/client-runtime": "workspace:*",
    "@octant/contracts": "workspace:*",
    "@octant/domain": "workspace:*",
    "expo": "~57.0.11",
    "expo-blur": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.9",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.8",
    "expo-linear-gradient": "~57.0.1",
    "expo-local-authentication": "~57.0.2",
    "expo-secure-store": "57.0.1",
    "expo-system-ui": "~57.0.2",
    "react": "catalog:",
    "react-dom": "19.2.7",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "babel-preset-expo": "~57.0.5",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  }
