{
  "name": "@octant/server",
  "private": true,
  "type": "module",
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsdown && bun ../../scripts/build-linux-sandbox-launch.ts --verify-relocatable-bundles",
    "browser:uploads:smoke": "bun src/browser/browserUploadFiles.smoke.ts",
    "browser:smoke": "bun src/browser/browserRuntime.smoke.ts",
    "desktop:cloud:smoke": "bun src/computerUse/cloudDesktop.smoke.ts",
    "canvas:browser:smoke": "bun src/canvas/canvasRendererBrowser.smoke.ts",
    "canvas:inventory:browser:smoke": "bun src/canvas/canvasInventoryBrowser.smoke.ts",
    "canvas:preview:browser:smoke": "bun src/canvas/canvasPreviewBrowser.smoke.ts",
    "canvas:export:frame:browser:smoke": "bun src/canvas/canvasExportFrameBrowser.smoke.ts",
    "db:backup": "bun src/maintenanceCli.ts backup",
    "db:rebuild": "bun src/maintenanceCli.ts rebuild",
    "db:remove": "bun src/maintenanceCli.ts remove",
    "db:import-octant": "bun src/maintenanceCli.ts import-octant",
    "db:list-credential-references": "bun src/maintenanceCli.ts list-credential-references",
    "db:reset": "bun src/maintenanceCli.ts reset",
    "db:restore": "bun src/maintenanceCli.ts restore",
    "db:status": "bun src/maintenanceCli.ts status",
    "db:verify": "bun src/maintenanceCli.ts verify",
    "remote:exit-evidence-a": "OCTANT_RUN_REMOTE_EXIT_EVIDENCE_A=1 tsc -p tsconfig.remote-evidence.json && OCTANT_RUN_REMOTE_EXIT_EVIDENCE_A=1 vitest run --maxWorkers=1 --testTimeout=300000 src/remote/remoteExitEvidenceA.smoke.test.ts",
    "sqlite:smoke:bun": "bun src/persistence/sqlitePort.smoke.ts",
    "sqlite:smoke:node": "node src/persistence/sqlitePort.smoke.ts",
    "start": "bun src/main.ts",
    "test": "bun ../../scripts/build-linux-sandbox-launch.ts && vitest run --project unit --project process --testTimeout=30000",
    "test:unit": "bun ../../scripts/build-linux-sandbox-launch.ts && vitest run --project unit --testTimeout=30000",
    "test:process": "bun ../../scripts/build-linux-sandbox-launch.ts && vitest run --project process --testTimeout=30000",
    "test:evidence": "vitest run --project evidence --testTimeout=300000",
    "egress-proxy:benchmark": "OCTANT_RUN_EGRESS_PROXY_BENCHMARK=1 vitest run --project evidence --testTimeout=600000 src/harness/nativeHarnessEgressProxy.benchmark.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "canvas:export:plugin:smoke": "bun src/canvas/canvasExportWorker.smoke.ts",
    "canvas:export:installed:smoke": "bun src/canvas/canvasExportInstalled.smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@jsquash/webp": "1.5.0",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@octant/cli": "workspace:*",
    "@octant/contracts": "workspace:*",
    "@octant/domain": "workspace:*",
    "@octant/host-runtime": "workspace:*",
    "@octant/plugin-api": "workspace:*",
    "@octant/plugin-host": "workspace:*",
    "@octant/provider-sdk": "workspace:*",
    "@octant/theme": "workspace:*",
    "@opencode-ai/sdk": "catalog:",
    "ajv": "8.20.0",
    "better-sqlite3": "catalog:",
    "effect": "catalog:",
    "jpeg-js": "0.4.4",
    "katex": "0.18.9",
    "node-pty": "catalog:",
    "omggif": "1.0.10",
    "playwright-core": "catalog:",
    "pngjs": "7.0.0",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@octant/client-runtime": "workspace:*",
    "@types/better-sqlite3": "catalog:",
    "@types/bun": "catalog:",
    "@types/omggif": "1.0.5",
    "@types/pngjs": "6.0.5",
    "tsdown": "0.22.5",
    "typescript": "catalog:",
    "unrun": "0.3.1",
    "vitest": "catalog:"
  }
}
