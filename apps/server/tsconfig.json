{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "types": ["bun", "node"]
  },
  "include": ["src"],
  // These import the client runtime's sources, whose `fetch` ports do not
  // satisfy Bun's `fetch` type (it adds `preconnect`). The client runtime
  // typechecks those sources under its own program; the driver has its own
  // program below, and the pairing-code smoke, the two-host forwarder test,
  // the guest smoke, the owners smoke (which admits a guest), the desktop
  // window smoke (which runs the window's federation stack), and the relay
  // smoke (which runs the desktop's client path through the hub) run under vitest.
  "exclude": [
    "src/hub/hubAndSpokes.relay.smoke.test.ts",
    "src/hub/hubAndSpokes.guest.smoke.test.ts",
    "src/hub/hubAndSpokes.owners.smoke.test.ts",
    "src/hub/hubAndSpokes.windowComputers.smoke.test.ts",
    "src/remote/pairedHistory.smoke.test.ts",
    "src/remote/remoteExitEvidenceADriver.ts",
    "src/remote/remotePairingCode.smoke.test.ts",
    "src/remote/remoteServerForwarder.twoHost.test.ts"
  ]
}
