{
  "name": "@octant/host-runtime",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./desktop-data-choice": "./src/desktopDataChoice.ts",
    "./desktop-identity": "./src/desktopIdentity.ts",
    "./owner-receipt": "./src/ownerReceipt.ts",
    "./paths": "./src/paths.ts",
    "./windows-desktop-launcher": "./src/windowsDesktopLauncher.ts",
    "./windows-host-profile": "./src/windowsHostProfile.ts"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsdown src/index.ts --format esm --dts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@octant/contracts": "workspace:*",
    "@octant/domain": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.22.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
