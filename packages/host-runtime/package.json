    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@octant/contracts": "workspace:*",
    "@octant/domain": "workspace:*"
  },
  "devDependencies": {
    "tsdown": "0.22.5",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
