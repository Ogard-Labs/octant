{
  "name": "@octant/host-runtime",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "build": "tsdown src/index.ts --format esm --dts",
